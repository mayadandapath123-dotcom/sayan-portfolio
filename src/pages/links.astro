---
import Layout from '@/components/Layout.astro';
---
<Layout title="Links — Sayan" description="My link control center: projects, social profiles, and other important internet destinations." active="links">
  <section class="section">
    <div class="container">
      <h1>My Links</h1>
      <p style="color:var(--color-text-muted);">
        The clean list of places I hang out online — projects first, everything else after.
        This is my link control center.
      </p>

      <section style="margin-top:2.5rem;">
        <h2 style="font-size:1.2rem; margin-bottom:1rem;">Projects</h2>
        <ul style="list-style:none; padding:0; color:var(--color-text-muted); font-size:1rem; line-height:2.2;">
          <li>→ <a href="/projects" style="color:var(--color-text);">Keysmith</a> — keyboard games & races</li>
          <li>→ <a href="/projects" style="color:var(--color-text);">Study Head Control</a> — head-movement accessibility experiment</li>
          <li>→ <a href="/projects" style="color:var(--color-text);">Internet Speed Tester</a> — browser speed check</li>
          <li>→ <a href="/projects" style="color:var(--color-text);">Linux Dotfiles</a> — my Linux setup</li>
          <li>→ <a href="/projects" style="color:var(--color-text);">Study Planner</a> — Class 10 revision tracker</li>
          <li style="color:var(--color-text-dim); font-size:0.9rem;">…and more on the <a href="/projects" style="color:var(--color-accent);">Projects</a> page.</li>
        </ul>
      </section>

      <section style="margin-top:2.5rem;">
        <h2 style="font-size:1.2rem; margin-bottom:1rem;">Social</h2>
        <ul style="list-style:none; padding:0; color:var(--color-text-muted); font-size:1rem; line-height:2.2;">
          <li>→ <a href="#" style="color:var(--color-text);">Instagram</a></li>
          <li>→ <a href="#" style="color:var(--color-text);">YouTube</a></li>
          <li>→ <a href="#" style="color:var(--color-text);">GitHub</a></li>
        </ul>
      </section>

      <section style="margin-top:2.5rem;">
        <h2 style="font-size:1.2rem; margin-bottom:1rem;">Other</h2>
        <ul style="list-style:none; padding:0; color:var(--color-text-muted); font-size:1rem; line-height:2.2;">
          <li>→ <a href="/about" style="color:var(--color-text);">About me</a></li>
          <li>→ <a href="/life" style="color:var(--color-text);">Life / Journey</a></li>
          <li>→ <a href="#" style="color:var(--color-text);">Resume</a></li>
          <li>→ <a href="#" style="color:var(--color-text);">Contact</a></li>
        </ul>
      </section>
    </div>
  </section>
</Layout>
