---
import Layout from '@/components/Layout.astro';
---
<Layout title="Life / Journey — Sayan" description="My personal timeline: places visited, experiments, milestones, and memories." active="life">
  <section class="section">
    <div class="container">
      <h1>Life / Journey</h1>
      <p style="color:var(--color-text-muted);">
        A private/public personal archive — trips, events, achievements, experiments, and
        memories. Not a social feed.
      </p>

      <section style="margin-top:3rem;">
        <h2 style="font-size:1.4rem; margin-bottom:1.5rem;">Timeline</h2>
        <div style="border-left:var(--border-soft); padding-left:1.2rem; color:var(--color-text-muted); font-size:0.95rem; line-height:2;">
          <p><strong>2026</strong></p>
          <p style="color:var(--color-text-dim); font-size:0.9rem;">Add your first life entry here.</p>
          <p style="margin-top:1.5rem;"><em>This page is a skeleton — real timeline entries come from content you add.</em></p>
        </div>
      </section>
    </div>
  </section>
</Layout>
